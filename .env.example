# Copy to .env.local and fill in. Never commit real values.

# Email HR signs in with
AUTH_EMAIL=hr@example.com

# Generate with: node scripts/hash-password.mjs "<password>"
AUTH_PASSWORD_HASH=scrypt:<salt>:<hash>

# Random string used to sign the session cookie, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
